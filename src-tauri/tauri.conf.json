{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Cuber",
  "version": "1.2.2",
  "identifier": "com.nick.cuber",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5190",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "create": false,
        "title": "Cuber",
        "width": 800,
        "height": 1000,
        "minWidth": 680,
        "minHeight": 800,
        "resizable": true,
        "center": true,
        "label": "main"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/icon.ico"
    ],
    "publisher": "Nicholas Walker",
    "copyright": "Copyright (c) 2026 Nicholas Walker",
    "shortDescription": "Solves a Rubik's Cube from its colours",
    "longDescription": "Paint the colours of your cube, press Solve, and follow the moves while the cube on the screen turns with you.",
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "installerHooks": "installer-hooks.nsh",
        "compression": "zlib"
      }
    }
  }
}
